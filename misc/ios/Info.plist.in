<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>luanti</string>
	<key>CFBundleIconFile</key>
	<string>luanti-icon.icns</string>
	<key>CFBundleName</key>
	<string>@PROJECT_NAME_CAPITALIZED@</string>
	<key>CFBundleDisplayName</key>
	<string>@PROJECT_NAME_CAPITALIZED@</string>
	<key>CFBundleIdentifier</key>
	<string>com.stemblocks.matematicasuperpiatta</string>
	<!-- Matematica Superpiatta app version (marketing). Independent of the
	     Luanti engine version (@VERSION_STRING@) reported internally. -->
	<key>CFBundleVersion</key>
	<string>1.3.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.3</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<!-- Export compliance: the app only uses standard HTTPS (via cURL), which is
	     exempt encryption, so App Store Connect won't ask per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Full-screen rendering on all devices. Without a launch screen iOS
	     treats the app as legacy and letterboxes it (black bars on the sides
	     in landscape on notch/Dynamic-Island iPhones). An empty UILaunchScreen
	     dict opts into native full-resolution rendering with no per-device
	     assets, so it scales elastically across every iPhone/iPad. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- No NSAppTransportSecurity exceptions: all shipped endpoints (discovery
	     Lambda, WISCOMS) are HTTPS and work under default ATS. The dev-only
	     http:// _local fallbacks are not shipped, so no local-networking
	     permission is needed (avoids the iOS Local Network prompt in review). -->
</dict>
</plist>
